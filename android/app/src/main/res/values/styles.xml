<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base: fondo oscuro de la app, sin action bar, para que el arranque no
         muestre un destello blanco antes de que cargue el WebView. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/miplanBg</item>
        <item name="android:statusBarColor">@color/miplanBg</item>
        <item name="android:navigationBarColor">@color/miplanBg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/miplanBg</item>
        <item name="android:windowBackground">@color/miplanBg</item>
        <item name="android:statusBarColor">@color/miplanBg</item>
        <item name="android:navigationBarColor">@color/miplanBg</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/miplanBg</item>
        <item name="android:background">@color/miplanBg</item>
        <item name="android:windowBackground">@color/miplanBg</item>
    </style>
</resources>
