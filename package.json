{
  "name": "mi-plan-aws",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Mi Plan AWS — panel local-first para trackear la ruta de certificaciones AWS",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert \"pwa|local-server\"",
    "test:pwa": "playwright test tests/e2e/pwa-offline.spec.ts",
    "shots": "playwright test tests/e2e/shots.spec.ts",
    "vault:demo": "vitest run tests/demo",
    "verify": "npm run lint && tsc --noEmit -p tsconfig.json && npm test && npm run build",
    "verify:all": "npm run verify && npm run test:e2e",
    "serve": "node scripts/serve.mjs",
    "serve:lan": "node scripts/serve.mjs --lan --open",
    "serve:lan:https": "node scripts/serve.mjs --lan --https",
    "cert:lan": "node scripts/make-cert.mjs",
    "test:server": "playwright test tests/e2e/local-server.spec.ts tests/e2e/local-server-https.spec.ts",
    "apk": "node scripts/build-apk.mjs",
    "apk:debug": "node scripts/build-apk.mjs --debug",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@fontsource/ibm-plex-serif": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.11.1",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.10.0",
    "gray-matter": "^4.0.3",
    "ical.js": "^1.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.2"
  }
}
